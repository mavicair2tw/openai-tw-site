# Required: media gallery metadata persistence (Turso/LibSQL)
# Remote example: libsql://your-database-your-org.turso.io
# Local example: file:./data/media-gallery.db
LIBSQL_URL=
# Required for remote Turso/LibSQL URLs, leave blank for file: URLs
LIBSQL_AUTH_TOKEN=

# Preferred simple path: Gemini image + video API
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Optional Vertex AI fallback for images
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: show delete buttons in the client UI
NEXT_PUBLIC_ALLOW_MEDIA_DELETE=false
# Optional: actually allow DELETE APIs on the server
MEDIA_DELETE_ENABLED=false
