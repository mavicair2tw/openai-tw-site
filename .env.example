# Required: image generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Required: Cloudflare D1 media gallery metadata persistence
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Required: Cloudflare R2 media storage
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Optional: override the default R2 endpoint
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Optional: media path prefix inside the bucket
# CLOUDFLARE_R2_PREFIX=media-gallery

# Optional: show delete buttons in the client UI
NEXT_PUBLIC_ALLOW_MEDIA_DELETE=false
# Optional: actually allow DELETE APIs on the server
MEDIA_DELETE_ENABLED=false
